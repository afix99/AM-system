# Local development (SQLite file)
DATABASE_URL="file:./dev.db"

# Production (Turso) — get these from turso.tech dashboard
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-auth-token-here"

# Auth — generate AUTH_SECRET with: openssl rand -base64 32
# Generate AUTH_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
AUTH_SECRET=""
AUTH_USERNAME=""
AUTH_PASSWORD_HASH=""
