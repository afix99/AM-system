generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id          String   @id @default(cuid())
  name        String
  location    String
  phone       String
  managerName String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff              Staff[]
  attendances        Attendance[]
  tasks              Task[]
  scheduleImages     ScheduleImage[]
  visits             Visit[]
  checklistTemplates ChecklistTemplate[]
  checklistRuns      ChecklistRun[]
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  phone     String
  storeId   String
  role      String   @default("Staff")
  hireDate  DateTime
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store           Store            @relation(fields: [storeId], references: [id])
  attendances     Attendance[]
  trainingRecords TrainingRecord[]
}

model Attendance {
  id        String   @id @default(cuid())
  staffId   String
  storeId   String
  date      DateTime
  status    String   @default("Present")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  storeId   String?
  priority  Int       @default(3)
  status    String    @default("pending")
  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id])
}

model WeeklyChecklist {
  id             String   @id @default(cuid())
  weekStartDate  DateTime
  items          String   @default("[]")
  completedItems String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScheduleImage {
  id            String   @id @default(cuid())
  storeId       String
  weekStartDate DateTime
  imageUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, weekStartDate])
}

model Visit {
  id          String   @id @default(cuid())
  storeId     String
  visitDate   DateTime
  notes       String
  photoUrls   String   @default("[]")
  actionItems String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

model LibraryEntry {
  id             String   @id @default(cuid())
  category       String
  title          String
  content        String
  attachmentUrls String   @default("[]")
  isTraining     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trainingRecords TrainingRecord[]
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  storeId   String
  type      String
  items     String   @default("[]")
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, type])
}

model ChecklistRun {
  id             String   @id @default(cuid())
  storeId        String
  type           String
  date           DateTime
  completedItems String   @default("[]")
  notes          String?
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, type, date])
}

model TrainingRecord {
  id             String   @id @default(cuid())
  staffId        String
  libraryEntryId String
  completedDate  DateTime
  notes          String?
  createdAt      DateTime @default(now())

  staff        Staff        @relation(fields: [staffId], references: [id])
  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id])

  @@unique([staffId, libraryEntryId])
}
